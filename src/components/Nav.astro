---
import { NAV, SITE } from "../consts";
import T from "../i18n/T.astro";
const { active } = Astro.props as { active?: string };
---
<header class="topbar">
  <div class="brand">
    <a href="/" class="mark">{SITE.brand}</a>
    <span class="latin">{SITE.latinBrand} / since {SITE.since}</span>
  </div>
  <nav id="primary-nav" aria-label="主导航" data-tt="aria-label" data-tt-aria-label="主导航|Primary navigation">
    {NAV.map((l) => (
      <a href={l.href} class={l.key === active ? "active" : ""}><T zh={l.label.zh} en={l.label.en} /></a>
    ))}
  </nav>
  <div class="meta-right">
    <button class="iconbtn search-icon" type="button" title="搜索 (⌘K)" aria-label="搜索" data-tt="title,aria-label" data-tt-title="搜索 (⌘K)|Search (⌘K)" data-tt-aria-label="搜索|Search">
      <svg class="icon"><use href="#icon-search"></use></svg>
    </button>
    <button class="iconbtn" type="button" id="theme-toggle-btn" title="切换暗色模式" aria-label="切换暗色模式">
      <svg class="icon" id="theme-icon-svg"><use href="#icon-moon"></use></svg>
    </button>
    <button class="iconbtn lang-toggle" type="button" id="lang-toggle-btn" aria-label="切换语言" data-tt="title,aria-label" data-tt-title="切换到 English|Switch to Chinese" data-tt-aria-label="切换语言|Switch language">
      <span class="t-zh">EN</span><span class="t-en">中</span>
    </button>
    <button class="iconbtn nav-toggle" type="button" id="nav-toggle-btn" aria-label="菜单" aria-controls="primary-nav" aria-expanded="false" data-tt="aria-label" data-tt-aria-label="菜单|Menu">
      <svg class="icon" id="nav-toggle-icon"><use href="#icon-menu"></use></svg>
    </button>
  </div>
</header>
