---
import { NAV, SITE } from "../consts";
const { active } = Astro.props as { active?: string };
---
<header class="topbar">
  <div class="brand">
    <a href="/" class="mark">{SITE.brand}</a>
    <span class="latin">{SITE.latinBrand} / since {SITE.since}</span>
  </div>
  <nav aria-label="主导航">
    {NAV.map((l) => (
      <a href={l.href} class={l.key === active ? "active" : ""}>{l.label}</a>
    ))}
  </nav>
  <div class="meta-right">
    <button class="iconbtn search-icon" type="button" title="搜索" aria-label="搜索">
      <svg class="icon"><use href="#icon-search"></use></svg>
    </button>
    <button class="iconbtn" type="button" id="theme-toggle-btn" title="切换暗色模式" aria-label="切换暗色模式">
      <svg class="icon" id="theme-icon-svg"><use href="#icon-moon"></use></svg>
    </button>
  </div>
</header>
