---
import { SITE, FRIENDS, NOW, SIDEBAR_LINKS } from "../consts";
interface Props {
  tags: { tag: string; size: string }[];
}
const { tags } = Astro.props;
---
<aside class="aside">
  <div class="about-card">
    <div class="corner"></div>
    <div class="head">
      <img src={SITE.avatar} alt={SITE.author} />
      <div>
        <div class="name">{SITE.author} · {SITE.handle}</div>
        <div class="role">{SITE.role}</div>
      </div>
    </div>
    <p class="bio"><span class="t-zh" data-pagefind-ignore>{SITE.bio}</span><span class="t-en" data-pagefind-ignore>{SITE.bioEn}</span></p>
    <p class="epigraph"><span class="t-zh" data-pagefind-ignore>{SITE.epigraphZh}</span><span class="t-en" data-pagefind-ignore>{SITE.epigraph}</span></p>
    <div class="links">
      {SIDEBAR_LINKS.map((l) => (
        <a
          href={l.href}
          title={l.title}
          data-tt={l.titleEn ? "title" : undefined}
          data-tt-title={l.titleEn ? `${l.title}|${l.titleEn}` : undefined}
        >{l.badge}</a>
      ))}
    </div>
  </div>

  <div class="now-card">
    <span class="stamp">/Now</span>
    {NOW.map((n) => (
      <div class="what">
        <span class="ico"><span class="t-zh" data-pagefind-ignore>{n.ico}</span><span class="t-en" data-pagefind-ignore>{n.icoEn}</span></span>
        <span class="t-zh" data-pagefind-ignore>{n.text}</span><span class="t-en" data-pagefind-ignore>{n.textEn}</span>
      </div>
    ))}
  </div>

  <div>
    <h5><span class="t-zh" data-pagefind-ignore>精选标签</span><span class="t-en" data-pagefind-ignore>Featured Tags</span></h5>
    <div class="tag-cloud">
      {tags.map((t) => (
        <a href={`/tags/#${encodeURIComponent(t.tag)}`} data-size={t.size}>{t.tag}</a>
      ))}
    </div>
  </div>

  <div>
    <h5><span class="t-zh" data-pagefind-ignore>友链</span><span class="t-en" data-pagefind-ignore>Friends</span></h5>
    <div class="friends">
      {FRIENDS.map((f) => (
        <a href={f.href} target="_blank" rel="noopener">
          <span class="dot"></span>
          <span>{f.title}</span>
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</aside>
