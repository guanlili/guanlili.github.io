---
import { SITE, FRIENDS, NOW } from "../consts";
interface Props {
  tags: { tag: string; size: string }[];
}
const { tags } = Astro.props;
---
<aside class="aside">
  <div class="about-card">
    <div class="corner"></div>
    <div class="head">
      <img src={SITE.avatar} alt="李梨" />
      <div>
        <div class="name">李梨 · outman</div>
        <div class="role">SOFTWARE ENG · UX</div>
      </div>
    </div>
    <p class="bio">热爱技术与测试，简单乐观，爱创造。Web &amp; Mobile Lover，业余写字、做菜、看星星。</p>
    <p class="epigraph">When you look up at the stars, don't forget to look down at the dust.</p>
    <div class="links">
      <a href="https://github.com/guanlili" title="GitHub">GH</a>
      <a href="https://www.zhihu.com/people/xiao-li-ge-ge-38" title="知乎">知</a>
      <a href="https://blog.csdn.net/outman_1921" title="CSDN">CS</a>
      <a href="/about/#follow" title="联系 / 订阅">@</a>
    </div>
  </div>

  <div class="now-card">
    <span class="stamp">/Now</span>
    {NOW.map((n) => (
      <div class="what"><span class="ico">{n.ico}</span>{n.text}</div>
    ))}
  </div>

  <div>
    <h5>Featured Tags / 标签</h5>
    <div class="tag-cloud">
      {tags.map((t) => (
        <a href={`/tags/#${encodeURIComponent(t.tag)}`} data-size={t.size}>{t.tag}</a>
      ))}
    </div>
  </div>

  <div>
    <h5>Friends / 友链</h5>
    <div class="friends">
      {FRIENDS.map((f) => (
        <a href={f.href} target="_blank" rel="noopener">
          <span class="dot"></span>
          <span>{f.title}</span>
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</aside>
