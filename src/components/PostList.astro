---
import type { LoadedPost } from "../lib/posts";
import { excerpt, readingStats } from "../lib/posts";

interface Props {
  posts: LoadedPost[];
  offset?: number; // running index of the first item (for the №)
  // Title heading level, picked so the titles follow the heading above them.
  headingLevel?: 3 | 4;
}
const { posts, offset = 0, headingLevel = 4 } = Astro.props;
const Title = `h${headingLevel}`;
const pad2 = (n: number) => String(n).padStart(2, "0");
---
<div class="posts">
  {posts.map((p, i) => {
    const d = p.entry.data.date;
    const ymd = `${d.getFullYear()}.${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}`;
    const { minutes } = readingStats(p.entry.body ?? "");
    const fill = Math.min(minutes, 60) / 60;
    return (
      <article class="post">
        <div class="num"><span class="t-zh" data-pagefind-ignore>第 {pad2(offset + i + 1)} 篇</span><span class="t-en" data-pagefind-ignore>No. {pad2(offset + i + 1)}</span></div>
        <div class="body">
          {p.entry.data.tags.length > 0 && (
            <div class="tags">
              {p.entry.data.tags.slice(0, 3).map((t) => (
                <a href={`/tags/#${encodeURIComponent(t)}`}>{t}</a>
              ))}
            </div>
          )}
          <Title><a href={p.route.path}>{p.entry.data.title}</a></Title>
          {p.entry.data.subtitle && <p class="dek">{p.entry.data.subtitle}</p>}
          <p class="preview">{excerpt(p.entry.body ?? "")}</p>
        </div>
        <div class="right">
          <span class="date">{ymd}</span>
          <span class="reading">
            <span class="t-zh" data-pagefind-ignore>{minutes} 分钟</span><span class="t-en" data-pagefind-ignore>{minutes} min</span>
            <span class="bar"><i style={`width:${fill * 100}%`}></i></span>
          </span>
        </div>
      </article>
    );
  })}
</div>
