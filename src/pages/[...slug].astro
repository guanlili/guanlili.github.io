---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import { SITE } from "../consts";
import { excerpt, firstImage, getPosts, readingStats, type LoadedPost } from "../lib/posts";
import { siteImage } from "../lib/media";
import { footprintPath, footprintPostPaths, getFootprints } from "../lib/footprints";
import { getCached, loadCache } from "../lib/image-cache.mjs";
import { ARTICLE_SCRIPT_VERSION } from "../lib/asset-version";
import "../styles/less/post-article.less";

const COS_HOST = "blog-1258476669.cos.ap-beijing.myqcloud.com";
const COVER_WIDTHS = [480, 800, 1200];

function buildCoverSrcset(src: string, width: number): string | undefined {
  if (!src.includes(COS_HOST) || width <= 800) return undefined;
  const widths = COVER_WIDTHS.filter((w) => w < width);
  if (widths.length < 2) return undefined;
  const sep = src.includes("?") ? "&" : "?";
  return [
    ...widths.map((w) => `${src}${sep}imageMogr2/thumbnail/${w}x ${w}w`),
    `${src} ${width}w`,
  ].join(", ");
}

export async function getStaticPaths() {
  const posts = await getPosts(); // newest-first, date-prefixed only
  const footprintsByPost = new Map<string, { city: string; province: string; path: string }[]>();
  for (const entry of await getFootprints()) {
    for (const path of footprintPostPaths(entry)) {
      if (!footprintsByPost.has(path)) footprintsByPost.set(path, []);
      footprintsByPost.get(path)!.push({ city: entry.data.city, province: entry.data.province, path: footprintPath(entry) });
    }
  }
  const postsByTag = new Map<string, LoadedPost[]>();
  for (const post of posts) {
    for (const tag of post.entry.data.tags || []) {
      if (!postsByTag.has(tag)) postsByTag.set(tag, []);
      postsByTag.get(tag)!.push(post);
    }
  }

  return posts.map((p, i) => {
    // Related articles: score only posts sharing at least one tag.
    const candidates = new Map<LoadedPost, number>();
    for (const tag of p.entry.data.tags || []) {
      for (const q of postsByTag.get(tag) || []) {
        if (q.route.path === p.route.path) continue;
        candidates.set(q, (candidates.get(q) ?? 0) + 1);
      }
    }

    const related = [...candidates.entries()]
      .map(([post, overlap]) => ({ post, overlap }))
      .sort((a, b) => b.overlap - a.overlap || b.post.entry.data.date.getTime() - a.post.entry.data.date.getTime())
      .slice(0, 3)
      .map((r) => ({
        title: r.post.entry.data.title,
        path: r.post.route.path,
        tags: r.post.entry.data.tags || [],
        date: r.post.entry.data.date,
      }));

    return {
      params: { slug: p.route.param },
      // older = next index, newer = previous index; n = sequence (newest = 01)
      props: { post: p.entry, older: posts[i + 1], newer: posts[i - 1], n: i + 1, related, footprints: footprintsByPost.get(p.route.path) ?? [] },
    };
  });
}

const { post, older, newer, n, related, footprints } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

loadCache();

const d = data.date;
const updated = data.updated ?? d;
const pad = (v: number) => String(v).padStart(2, "0");
const ymd = `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
const noN = pad(n); // article number, e.g. 01 (newest)
const { chars, minutes } = readingStats(post.body ?? "");

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const sectionCount = headings.filter((h) => h.depth === 2).length;
const olderPath = older ? older.route.path : null;
const newerPath = newer ? newer.route.path : null;
const description = data.description || data.subtitle || excerpt(post.body ?? "", 155);
// Only show an authored summary when it adds something beyond the subtitle.
const showBrief = Boolean(data.description?.trim() && data.description.trim() !== data.subtitle?.trim());
const coverImage =
  siteImage(data.cover) ??
  siteImage(data["header-img"]) ??
  siteImage(firstImage(post.body ?? ""));
const coverDim =
  coverImage && /^https?:\/\//.test(coverImage) ? getCached(coverImage) : null;
const coverImageSrcset = coverDim
  ? buildCoverSrcset(coverImage!, coverDim.w)
  : undefined;
const coverSizes = coverDim ? "(min-width: 880px) 880px, 100vw" : undefined;
const articleScriptVersion = ARTICLE_SCRIPT_VERSION;
---
<BaseLayout
  title={data.title}
  description={description || SITE.description}
  image={coverImage}
  type="article"
  indexable
  bodyClass="layout-post"
  article={{ date: d, updated, author: data.author || SITE.author, tags: data.tags }}
>
  <div class="article-shell">
    <section class="article-head">
      <div class="kicker">
        <span class="rule"></span>
        <span class="t-zh" data-pagefind-ignore>第 {noN} 篇 · 手稿</span><span class="t-en" data-pagefind-ignore>No. {noN} · Essay</span>
        <span class="rule"></span>
      </div>
      <h1 data-pagefind-meta="title" data-pagefind-weight="10">{data.title}</h1>
      {data.subtitle && <p class="deck" data-pagefind-weight="3">{data.subtitle}</p>}
      <div class="byline">
        <span class="author">
          <img src={SITE.avatar} alt="" />
          <span>{SITE.author} / {SITE.handle}</span>
        </span>
        <span class="sep"></span>
        <span>{ymd}</span>
        <span class="sep"></span>
        <span><span class="t-zh" data-pagefind-ignore>{minutes} 分钟阅读 · 约 {chars} 字</span><span class="t-en" data-pagefind-ignore>{minutes} min read · {chars} chars</span></span>
      </div>
      {data.tags.length > 0 && (
        <div class="article-topics" aria-label="文章标签" data-tt="aria-label" data-tt-aria-label="文章标签|Article tags" data-pagefind-weight="4">
          {data.tags.map((tag) => <a href={`/tags/#${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
      )}
    </section>

    {coverImage && (
      <figure class="article-cover">
        <img
          src={coverImage}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width={coverDim?.w}
          height={coverDim?.h}
          srcset={coverImageSrcset}
          sizes={coverSizes}
        />
        <figcaption>{data.title}</figcaption>
      </figure>
    )}

    {showBrief && (
      <aside class="reading-brief" aria-label="文章摘要" data-tt="aria-label" data-tt-aria-label="文章摘要|Article summary" data-pagefind-ignore>
        <span class="label t-zh" data-pagefind-ignore>导读</span><span class="label t-en" data-pagefind-ignore>TL;DR</span>
        <p>{data.description}</p>
      </aside>
    )}

    <div class="article-body">
      <aside class="gutter" aria-hidden="true">
        <span class="num">{noN}</span>
        <span class="progress-track"><span class="progress-fill"></span></span>
        <span class="progress-label">0%</span>
      </aside>

      <div class="article-content">
        <Content />
      </div>

      {toc.length > 0 && (
        <nav class="toc" aria-label="文章目录" data-tt="aria-label" data-tt-aria-label="文章目录|Table of contents">
          <div class="lbl"><span class="t-zh" data-pagefind-ignore>本期看点 · {sectionCount || toc.length}</span><span class="t-en" data-pagefind-ignore>In This Issue · {sectionCount || toc.length}</span></div>
          <ol>
            {toc.map((h) => (
              <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      {toc.length > 0 && (
        <button class="toc-fab" aria-label="打开目录" title="目录" data-tt="aria-label,title" data-tt-aria-label="打开目录|Open contents" data-tt-title="目录|Contents">
          <svg class="icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" y1="4" x2="17" y2="4"/><line x1="3" y1="8" x2="14" y2="8"/><line x1="3" y1="12" x2="17" y2="12"/><line x1="3" y1="16" x2="14" y2="16"/></svg>
        </button>
      )}

      {toc.length > 0 && (
        <div class="toc-sheet" aria-hidden="true" inert>
          <div class="toc-sheet-head">
            <span><span class="t-zh" data-pagefind-ignore>目录</span><span class="t-en" data-pagefind-ignore>Contents</span></span>
            <button class="toc-sheet-close" aria-label="关闭目录" data-tt="aria-label" data-tt-aria-label="关闭目录|Close contents">&times;</button>
          </div>
          <ol>
            {toc.map((h) => (
              <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </div>
      )}
    </div>

    <div class="article-end">
      <span class="t-zh" data-pagefind-ignore>— 完 —</span><span class="t-en" data-pagefind-ignore>— End —</span>
      <span class="glyph">&#10086;</span>
      <span><span class="t-zh" data-pagefind-ignore>{ymd} · 北京</span><span class="t-en" data-pagefind-ignore>{ymd} · Beijing</span></span>
    </div>

    {footprints.length > 0 && (
      <section class="related-posts related-footprints" data-pagefind-ignore>
        <div class="related-label"><span class="t-zh" data-pagefind-ignore>相关足迹</span><span class="t-en" data-pagefind-ignore>Footprints</span></div>
        <div class="related-list">
          {footprints.map((f) => (
            <a class="related-card" href={f.path}>
              <span class="rc-title">{f.city}</span>
              <span class="rc-meta"><span class="rc-tag">{f.province}</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="related-posts">
        <div class="related-label"><span class="t-zh" data-pagefind-ignore>继续阅读</span><span class="t-en" data-pagefind-ignore>Related</span></div>
        <div class="related-list">
          {related.map((r: { title: string; path: string; tags: string[]; date: Date }) => {
            const rd = r.date;
            const rymd = `${rd.getFullYear()}.${String(rd.getMonth() + 1).padStart(2, "0")}.${String(rd.getDate()).padStart(2, "0")}`;
            return (
              <a class="related-card" href={r.path}>
                <span class="rc-title">{r.title}</span>
                <span class="rc-meta">
                  {r.tags.slice(0, 3).map((t: string) => <span class="rc-tag">{t}</span>)}
                  <span class="rc-date">{rymd}</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <div class="next-prev">
      {newerPath ? (
        <a href={newerPath}>
          <span class="nav-lbl"><span class="t-zh" data-pagefind-ignore>&larr; 上一篇</span><span class="t-en" data-pagefind-ignore>&larr; Prev</span></span>
          <span class="nav-ttl">{newer!.entry.data.title}</span>
        </a>
      ) : (
        <span class="np-empty"><span class="nav-lbl"><span class="t-zh" data-pagefind-ignore>已是最新</span><span class="t-en" data-pagefind-ignore>Latest</span></span><span class="nav-ttl"><span class="t-zh" data-pagefind-ignore>没有更新的文章了</span><span class="t-en" data-pagefind-ignore>Nothing newer</span></span></span>
      )}
      {olderPath ? (
        <a href={olderPath}>
          <span class="nav-lbl"><span class="t-zh" data-pagefind-ignore>下一篇 &rarr;</span><span class="t-en" data-pagefind-ignore>Next &rarr;</span></span>
          <span class="nav-ttl">{older!.entry.data.title}</span>
        </a>
      ) : (
        <span class="np-empty"><span class="nav-lbl"><span class="t-zh" data-pagefind-ignore>已到底</span><span class="t-en" data-pagefind-ignore>The end</span></span><span class="nav-ttl"><span class="t-zh" data-pagefind-ignore>没有更早的文章了</span><span class="t-en" data-pagefind-ignore>Nothing older</span></span></span>
      )}
    </div>

    <Giscus />
  </div>

  <script is:inline defer src={`/js/site-article.js?v=${encodeURIComponent(articleScriptVersion)}`}></script>
</BaseLayout>
