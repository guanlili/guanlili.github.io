---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SECONDARY_PLATFORMS } from "../consts";
import { getPosts } from "../lib/posts";
import { Content as About } from "../content/about.md";

const posts = await getPosts();
const tagCount = new Set(posts.flatMap((p) => p.entry.data.tags)).size;
const years = new Date().getFullYear() - SITE.since;
const host = new URL(SITE.url).host;
---
<BaseLayout active="about" title="About" description="他单纯只想把日子过得不浪费">
  <div class="article-shell">
    <section class="page-head">
      <div>
        <div class="kicker">
          <span class="dot"></span>
          <span>About · 关于此人</span>
          <span class="rule"></span>
          <span>第一人称</span>
        </div>
        <h1>关于我，<br />{SITE.author} ({SITE.handle})</h1>
        <p class="sub">{SITE.author}，{SITE.bio}<br />{SITE.epigraph}</p>
      </div>
      <div class="right">
        <div class="big">{years}</div>
        <div>Years Writing</div>
        <div style="margin-top:10px">· · ·</div>
        <div>Beijing</div>
        <div>est. MMXVII</div>
      </div>
    </section>

    <div class="about-grid">
      <article class="long-form">
        <About />

        <h2>履历 / Path</h2>
        <div class="sub-h">Professional Trajectory</div>
        <div class="timeline-mini">
          <div class="row"><span class="y">NOW</span><span class="b">超级个体 · AI 研发 / 架构 <small>带一支小队做内部 AI 平台，主攻文生视频、私域知识库与代码生成三条主线。</small></span></div>
          <div class="row"><span class="y">2025</span><span class="b">PMO → All in AI <small>从管人到管 AI。把过去两年的管理沉淀塞回键盘，做出几个让自己满意的 AI 产品。</small></span></div>
          <div class="row"><span class="y">2024</span><span class="b">全栈 → PMO <small>从「螺丝钉」抬头看「流水线」。换个视角，第一次看清公司是怎么运转的，账是怎么算的。</small></span></div>
          <div class="row"><span class="y">2022</span><span class="b">校招 · 测试开发 → 全栈 <small>从测试岗回到代码一线。先后落地 API 平台、Mock 质量体系、AI 编码助手——串起来就是一句「研发提效」。</small></span></div>
          <div class="row"><span class="y">2020</span><span class="b">QA 实习 · 进入第一家大厂 <small>实习两年，熬成组里最老的「员工」。分单、定价、导流，覆盖网约车交易引擎全部业务——被毒打得很彻底，也长得很快。</small></span></div>
          <div class="row"><span class="y">2019</span><span class="b">进京读研 · 开始写博客 <small>要学的知识太多。于自己，对抗遗忘；于他人，多少有点用。</small></span></div>
        </div>
      </article>

      <aside class="about-side">
        <div class="portrait">
          <div class="img-box"><img src={SITE.avatar} alt={SITE.author} /></div>
          <div class="caption">
            <span>Li Li </span>
            <span class="accent">No. {posts.length}</span>
          </div>
        </div>

        <div class="quotebox">
          离开世界之前，<br />一切都是过程。
          <span class="attr">— Site Motto</span>
        </div>

        <div class="stat-strip">
          <div><div class="lbl">Posts</div><div class="val">{posts.length}</div></div>
          <div><div class="lbl">Years</div><div class="val">{years}</div></div>
          <div><div class="lbl">Tags</div><div class="val">{tagCount}</div></div>
          <div><div class="lbl">Coffee</div><div class="val">∞</div></div>
        </div>
      </aside>
    </div>

    <section id="follow" class="follow-block">
      <header class="head">
        <div>
          <div class="kicker">
            <span class="rule"></span>
            <span>Follow · 保持联系</span>
            <span class="rule"></span>
          </div>
          <h2>微信公众号 &amp; 小红书<small>两个主阵地 · Two Primary Channels</small></h2>
        </div>
        <div class="note">
          长文 + 技术更新看公众号「{SITE.wechatName}」，<br />
          生活向 + AI 折腾日常看小红书。<br />
          其他平台同步分发，挑顺手的即可。
        </div>
      </header>

      <div class="primary-channels">
        <article class="channel-hero is-wechat">
          <img src="/img/weixin-qrcode.png" alt={`微信 · ${SITE.wechatName} · 微信搜一搜搜索昵称添加`} loading="lazy" />
          <div class="label"><span class="accent">微信搜一搜「{SITE.wechatName}」</span></div>
        </article>
        <article class="channel-hero is-red">
          <img src="/img/redbook-qrcode.png" alt={`小红书 · ${SITE.wechatName} · 扫码关注`} loading="lazy" />
          <div class="label"><span class="accent">小红书号 {SITE.redbookId}</span></div>
        </article>
      </div>

      <section class="secondary-channels">
        <div class="head-row">
          <span>同步分发 · Also Posted To</span>
          <span class="count"><em>{SECONDARY_PLATFORMS.length}</em> Platforms</span>
        </div>
        <ul>
          {SECONDARY_PLATFORMS.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener">
                <span class="badge">{p.badge}</span>
                <span class="nm">{p.name}<small>{p.en}</small></span>
                <span class="handle">{p.handle}<span class="arr">↗</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="contact-letter" aria-labelledby="contact-heading">
        <div class="body">
          <div class="kicker">Direct · 来信</div>
          <h3 id="contact-heading">想说点什么，就写一封吧。</h3>
          <a class="cta" href={`mailto:${SITE.email}`}>
            <span class="addr">{SITE.email}</span>
            <span class="arrow">写信 ↗</span>
          </a>
          <p class="note">正事、合作、长信请走邮箱，响应大概「按周计」。广告与营销邮件请绕道，谢谢。</p>
        </div>
        <aside class="stamp" aria-hidden="true">
          <div class="seal">{SITE.brand.slice(0, 1)}</div>
          <div class="postmark">
            <span>{host}</span>
            <span>EST. {SITE.since}</span>
          </div>
        </aside>
      </section>
    </section>
  </div>
</BaseLayout>
