---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import Feature from "../components/Feature.astro";
import Sidebar from "../components/Sidebar.astro";
import { getPosts, readingStats } from "../lib/posts";
import { SITE } from "../consts";

const posts = await getPosts();
const featured = posts[0];
const recent = posts.slice(1, 11);
const host = new URL(SITE.url).host;
const focusPillars = [
  { zh: "AI 工程", en: "AI Engineering" },
  { zh: "测试开发", en: "Test Development" },
  { zh: "独立产品", en: "Indie Products" },
  { zh: "效率工具", en: "Productivity Tools" },
];

// real metrics
const totalChars = posts.reduce(
  (a, p) => a + readingStats(p.entry.body ?? "").chars,
  0,
);
const wan = (totalChars / 10000).toFixed(1);
const latest = posts[0]?.entry.data.date;
const pad2 = (n: number) => String(n).padStart(2, "0");
const latestYmd = latest
  ? `${latest.getFullYear()}.${pad2(latest.getMonth() + 1)}.${pad2(latest.getDate())}`
  : "";

// sidebar tag cloud (top 18 by frequency)
const counts = new Map<string, number>();
for (const p of posts)
  for (const t of p.entry.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const sizeFor = (n: number) =>
  n >= 8 ? "xl" : n >= 4 ? "lg" : n >= 2 ? "md" : "sm";
const sidebarTags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 18)
  .map(([tag, n]) => ({ tag, size: sizeFor(n) }));
const topTags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN"))
  .slice(0, 6)
  .map(([tag, n]) => ({ tag, n }));

const sectionNames = new Map<string, string>([
  ["AI", "AI"],
  ["Tutorials", "教程"],
  ["study", "学习"],
  ["blogSet", "博客搭建"],
  ["findJob", "求职"],
  ["myself", "随笔"],
  ["problemList", "问题排查"],
  ["leetcode", "算法"],
  ["essays", "杂文"],
]);
const sectionNamesEn = new Map<string, string>([
  ["AI", "AI"],
  ["Tutorials", "Tutorials"],
  ["study", "Study"],
  ["blogSet", "Blog Setup"],
  ["findJob", "Job Hunt"],
  ["myself", "Essays"],
  ["problemList", "Debugging"],
  ["leetcode", "Algorithms"],
  ["essays", "Misc"],
]);
const sections = new Map<string, number>();
for (const p of posts) {
  const raw = (p.entry.filePath ?? p.entry.id).split("/").slice(-2, -1)[0] || "blog";
  sections.set(raw, (sections.get(raw) ?? 0) + 1);
}
const topSections = [...sections.entries()]
  .sort((a, b) => b[1] - a[1] || (sectionNames.get(a[0]) ?? a[0]).localeCompare(sectionNames.get(b[0]) ?? b[0], "zh-CN"))
  .slice(0, 5)
  .map(([raw, n]) => ({ name: sectionNames.get(raw) ?? raw, nameEn: sectionNamesEn.get(raw) ?? raw, n }));
const latestRead = featured ? readingStats(featured.entry.body ?? "") : null;

// motto headline, split across two lines like the design
const motto = "离开世界之前 一切都是过程";
const mp = motto.split(" ");
const line1 = mp.slice(0, Math.ceil(mp.length / 2)).join(" ");
const line2 = mp.slice(Math.ceil(mp.length / 2)).join(" ");
const totalKChars = Math.round(totalChars / 1000);
---
<BaseLayout active="home" description={SITE.description}>
  <div class="article-shell">
    <section class="masthead">
      <div class="left">
        <div class="kicker">
          <span class="dot"></span>
          <span>Since {SITE.since} · <span class="t-zh" data-pagefind-ignore>手稿 {posts.length} 篇</span><span class="t-en" data-pagefind-ignore>{posts.length} essays</span></span>
          <span class="rule"></span>
          <span>{latest?.getFullYear()}</span>
        </div>
        <h1>
          <span class="t-zh" data-pagefind-ignore>{line1}<br /><span class="quote-mk">「</span>{line2}<span class="quote-mk">」</span></span>
          <span class="t-en" data-pagefind-ignore>Everything is a journey<br />before we leave this world</span>
        </h1>
        <p class="sub">
          <span class="t-zh" data-pagefind-ignore>这里是 <em>{SITE.author}（{SITE.handle}）</em> 的个人博客——一个写 AI、聊架构、记录踩坑日常的小角落。写作是把模糊的思考晾在阳光下，逼自己说人话。</span>
          <span class="t-en" data-pagefind-ignore>The personal blog of <em>{SITE.author} ({SITE.handle})</em> — a small corner for writing about AI, architecture, and the everyday potholes of engineering. Writing airs fuzzy thinking in the sun and forces me to speak plainly.</span>
        </p>
        <div class="focus-pills" aria-label="写作方向" data-tt="aria-label" data-tt-aria-label="写作方向|Writing focus">
          {focusPillars.map((item) => <span><span class="t-zh" data-pagefind-ignore>{item.zh}</span><span class="t-en" data-pagefind-ignore>{item.en}</span></span>)}
        </div>
      </div>
      <div class="right">
        <div class="issue">{posts.length}</div>
        <div><span class="t-zh" data-pagefind-ignore>篇 · 手稿</span><span class="t-en" data-pagefind-ignore>Essays</span></div>
        <div><span class="t-zh" data-pagefind-ignore>EST. {SITE.since} · 北京</span><span class="t-en" data-pagefind-ignore>EST. {SITE.since} · Beijing</span></div>
        <div style="margin-top:10px;color:var(--ink-4)">{host}</div>
      </div>
      <div class="vertical-accent"><span class="t-zh" data-pagefind-ignore>仰望星空，俯首尘埃</span><span class="t-en" data-pagefind-ignore>Stars above, dust below</span></div>
    </section>

    <div class="index-strip">
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>本期主笔</span><span class="t-en" data-pagefind-ignore>Featured Author</span></span><span class="value">{SITE.author} · {SITE.handle}</span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>累计文章</span><span class="t-en" data-pagefind-ignore>Total Posts</span></span><span class="value"><span class="t-zh" data-pagefind-ignore>{posts.length} 篇 · 约 {wan}w 字</span><span class="t-en" data-pagefind-ignore>{posts.length} posts · ~{totalKChars}k chars</span></span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>最新更新</span><span class="t-en" data-pagefind-ignore>Latest Update</span></span><span class="value">{latestYmd}</span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>订阅 · 公众号</span><span class="t-en" data-pagefind-ignore>Subscribe · WeChat</span></span><span class="value"><span class="t-zh" data-pagefind-ignore>微信「{SITE.wechatName}」</span><span class="t-en" data-pagefind-ignore>WeChat “{SITE.wechatName}”</span></span></div>
    </div>

    <section class="home-radar" aria-label="博客写作雷达" data-tt="aria-label" data-tt-aria-label="博客写作雷达|Blog writing radar">
      <div class="radar-card radar-lead">
        <span class="label"><span class="t-zh" data-pagefind-ignore>当前信号</span><span class="t-en" data-pagefind-ignore>Current Signal</span></span>
        <strong>{featured?.entry.data.title}</strong>
        <small>
          <span class="t-zh" data-pagefind-ignore>{latestRead ? `${latestRead.minutes} 分钟 · 约 ${latestRead.chars} 字` : "最近更新"}</span>
          <span class="t-en" data-pagefind-ignore>{latestRead ? `${latestRead.minutes} min · ${latestRead.chars} chars` : "Latest"}</span>
        </small>
      </div>
      <div class="radar-card">
        <span class="label"><span class="t-zh" data-pagefind-ignore>热门标签</span><span class="t-en" data-pagefind-ignore>Hot Tags</span></span>
        <div class="radar-tags">
          {topTags.map((item) => (
            <a href={`/tags/#${encodeURIComponent(item.tag)}`}>
              <span>{item.tag}</span>
              <em>{item.n}</em>
            </a>
          ))}
        </div>
      </div>
      <div class="radar-card">
        <span class="label"><span class="t-zh" data-pagefind-ignore>知识图谱</span><span class="t-en" data-pagefind-ignore>Knowledge Map</span></span>
        <div class="radar-bars">
          {topSections.map((item) => (
            <div>
              <span><span class="t-zh" data-pagefind-ignore>{item.name}</span><span class="t-en" data-pagefind-ignore>{item.nameEn}</span></span>
              <i style={`--w:${Math.max(12, (item.n / posts.length) * 100)}%`}></i>
              <em>{item.n}</em>
            </div>
          ))}
        </div>
      </div>
    </section>

    {featured && <Feature post={featured} />}

    <div class="layout-main">
      <section>
        <header class="section-head">
          <h3><span class="t-zh" data-pagefind-ignore>近期手稿</span><span class="t-en" data-pagefind-ignore>Recent Posts</span></h3>
          <span class="count"><span class="t-zh" data-pagefind-ignore><em>{recent.length}</em> 篇 / 共 {posts.length} 篇</span><span class="t-en" data-pagefind-ignore><em>{recent.length}</em> of {posts.length}</span></span>
        </header>
        <PostList posts={recent} offset={1} />
        <div class="see-all">
          <a href="/archive/"><span class="t-zh" data-pagefind-ignore>查看全部归档 ↗</span><span class="t-en" data-pagefind-ignore>See all archives ↗</span></a>
        </div>
      </section>
      <Sidebar tags={sidebarTags} />
    </div>
  </div>
</BaseLayout>
