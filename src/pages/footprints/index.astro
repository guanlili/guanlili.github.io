---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FootprintMap from "../../components/footprints/FootprintMap.astro";
import { footprintDateLabel, footprintSlug, getFootprints, latestVisit, yearRange } from "../../lib/footprints";
import "../../styles/pages/footprints.less";

const footprints = await getFootprints();
const provinces = new Set(footprints.map((entry) => entry.data.province));
const homeBase = footprints.find((entry) => entry.data.status === "home");
const travelFootprints = footprints.filter((entry) => entry.data.status === "visited");
const travelVisits = travelFootprints.reduce((sum, entry) => sum + entry.data.visited.length, 0);
const years = footprints.flatMap((entry) => entry.data.visited.map((date) => date.getFullYear()));
const firstYear = years.length ? Math.min(...years) : new Date().getFullYear();
const latestTrip = travelFootprints[0];
const contentLabel = (entry: (typeof footprints)[number]) => entry.data.photos.length > 0
  ? "有照片"
  : entry.data.events.length > 1
    ? "有游记"
    : "仅足迹";
const contentLabelEn = (entry: (typeof footprints)[number]) => entry.data.photos.length > 0
  ? "Photos"
  : entry.data.events.length > 1
    ? "Journal"
    : "Footprint";
const contentKey = (entry: (typeof footprints)[number]) => entry.data.photos.length > 0
  ? "photos"
  : entry.data.events.length > 1
    ? "journal"
    : "footprint";
const archivedTrips = travelFootprints.reduce((groups, entry) => {
  const year = latestVisit(entry).getFullYear();
  const group = groups.get(year) ?? [];
  group.push(entry);
  groups.set(year, group);
  return groups;
}, new Map<number, typeof travelFootprints>());
const archiveYears = [...archivedTrips.keys()].sort((a, b) => b - a);
const residenceFootprints = footprints.filter((entry) => entry.data.status !== "visited");
// Counts mirror the client-side filter: a year matches any visit in that year
// (travel rows only), content matches every row.
const yearCounts = new Map(archiveYears.map((year) => [
  year,
  travelFootprints.filter((entry) => entry.data.visited.some((date) => date.getFullYear() === year)).length,
]));
const contentFilters = [
  { key: "photos", label: { zh: "有照片", en: "Photos" } },
  { key: "journal", label: { zh: "有游记", en: "Journal" } },
  { key: "footprint", label: { zh: "仅足迹", en: "Footprint" } },
].map((filter) => ({ ...filter, count: footprints.filter((entry) => contentKey(entry) === filter.key).length }));
const archiveNumber = new Map(footprints.map((entry, index) => [footprintSlug(entry), index + 1]));
const places = footprints.map((entry) => ({
  slug: footprintSlug(entry),
  title: entry.data.title,
  province: entry.data.province,
  prefecture: entry.data.prefecture,
  city: entry.data.city,
  coordinates: entry.data.coordinates,
  visited: entry.data.visited.map((date) => date.toISOString().slice(0, 10)),
  summary: entry.data.summary,
  cover: entry.data.cover,
  status: entry.data.status,
  since: entry.data.since?.toISOString().slice(0, 10),
  until: entry.data.until?.toISOString().slice(0, 10),
  journeys: entry.data.journeys.map((journey) => ({
    ...journey,
    date: journey.date.toISOString().slice(0, 10),
  })),
  contentLabel: contentLabel(entry),
  contentLabelEn: contentLabelEn(entry),
  sample: entry.data.sample,
}));
---

<BaseLayout active="footprints" title="我的足迹" description="在地图上，重新经过那些抵达过的地方。">
  <div class="article-shell footprints-page">
    <section class="page-head footprints-head">
      <div>
        <div class="kicker">
          <span class="dot"></span>
          <span><span class="t-zh">我的足迹</span><span class="t-en">Footprints</span></span>
          <span class="rule"></span>
          <span><span class="t-zh">去过的地方</span><span class="t-en">Places I Have Been</span></span>
        </div>
        <h1><span class="t-zh">地图展开，<br />故事才刚刚开始。</span><span class="t-en">Unfold the map,<br />and the stories begin.</span></h1>
        <p class="sub">
          <span class="t-zh">在地图上，重新经过那些抵达过的地方。这里收下沿途的文字、照片，以及一些后来才明白的事情。</span>
          <span class="t-en">Revisit, on a map, the places I once arrived at. Words and photos from the road, and a few things only understood later.</span>
        </p>
      </div>
    </section>

    {footprints.some((entry) => entry.data.sample) && (
      <aside class="sample-notice">
        <span><span class="t-zh">示例数据</span><span class="t-en">Prototype</span></span>
        <p><span class="t-zh">目前用四座城市演示版式与交互，地点、日期和文字请按你的真实经历替换；示例照片来自 Unsplash。</span><span class="t-en">Four cities currently demonstrate the layout and interactions — replace places, dates and copy with your own story. Sample photos are from Unsplash.</span></p>
      </aside>
    )}

    <div class="footprints-strip">
      <div><span class="label"><span class="t-zh">常驻</span><span class="t-en">Home Base</span></span><span class="value">{homeBase ? `${homeBase.data.city} · Since ${homeBase.data.since?.getFullYear() ?? firstYear}` : "—"}</span></div>
      <div><span class="label"><span class="t-zh">省级地区</span><span class="t-en">Provinces</span></span><span class="value"><span class="t-zh">{provinces.size} 个省级地区</span><span class="t-en">{provinces.size} provinces</span></span></div>
      <div><span class="label"><span class="t-zh">旅行记录</span><span class="t-en">Travel Log</span></span><span class="value"><span class="t-zh">{travelVisits} 次抵达 · {travelFootprints.length} 个地点</span><span class="t-en">{travelVisits} visits · {travelFootprints.length} places</span></span></div>
      <div><span class="label"><span class="t-zh">最近旅行</span><span class="t-en">Latest Trip</span></span><span class="value">{latestTrip ? `${latestTrip.data.city} · ${footprintDateLabel(latestVisit(latestTrip), latestTrip.data.precision)}` : "—"}</span></div>
    </div>

    <FootprintMap places={places} />

    <section class="footprint-index" data-footprint-archive>
      <header class="section-head">
        <h3><span class="t-zh">抵达记录</span><span class="t-en">Arrivals</span></h3>
        <span class="latin">Journey Archive</span>
        <span class="count"><em data-archive-count>{footprints.length}</em> <span class="t-zh">个地点</span><span class="t-en">Places</span></span>
      </header>
      <div class="archive-toolbar" aria-label="筛选足迹记录" data-tt="aria-label" data-tt-aria-label="筛选足迹记录|Filter journey records">
        <div class="archive-filter-group">
          <span><span class="t-zh">年份</span><span class="t-en">Year</span></span>
          <button type="button" class="active" data-archive-year="" aria-pressed="true"><span class="t-zh">全部</span><span class="t-en">All</span></button>
          {archiveYears.map((year) => <button type="button" data-archive-year={year} aria-pressed="false">{year}<small>{yearCounts.get(year)}</small></button>)}
        </div>
        <div class="archive-filter-group archive-content-filter">
          <span><span class="t-zh">内容</span><span class="t-en">Content</span></span>
          <button type="button" class="active" data-archive-content="" aria-pressed="true"><span class="t-zh">全部</span><span class="t-en">All</span></button>
          {contentFilters.map((filter) => (
            <button type="button" data-archive-content={filter.key} aria-pressed="false" disabled={filter.count === 0}>
              <span class="t-zh">{filter.label.zh}</span><span class="t-en">{filter.label.en}</span><small>{filter.count}</small>
            </button>
          ))}
        </div>
        <div class="archive-filter-state"><span data-archive-province>全部地区</span><button type="button" data-archive-reset data-tt="aria-label" data-tt-aria-label="清除筛选|Clear filters"><span class="t-zh">清除筛选</span><span class="t-en">Clear filters</span></button></div>
      </div>

      <div class="journey-years">
        {archiveYears.map((year, groupIndex) => {
          const entries = archivedTrips.get(year) ?? [];
          return (
            <details class="journey-year" data-archive-group data-year={year} open={groupIndex < 2}>
              <summary><strong>{year}</strong><span><span class="t-zh">{entries.length} 个地点</span><span class="t-en">{entries.length} places</span></span><i aria-hidden="true">＋</i></summary>
              <div class="journey-rows">
                {entries.map((entry) => (
                  <a
                    class:list={["journey-row", `status-${entry.data.status}`]}
                    href={`/footprints/${footprintSlug(entry)}/`}
                    data-archive-entry
                    data-province={entry.data.province}
                    data-journeys={entry.data.journeys.map((journey) => journey.id).join(",")}
                    data-years={entry.data.visited.map((date) => date.getFullYear()).join(",")}
                    data-content={contentKey(entry)}
                  >
                    <span class="journey-num"><span class="t-zh">第 {String(archiveNumber.get(footprintSlug(entry))).padStart(2, "0")} 站</span><span class="t-en">No. {String(archiveNumber.get(footprintSlug(entry))).padStart(2, "0")}</span></span>
                    <span class="journey-row-copy">
                      <span class="journey-meta"><span class="t-zh">城市 · {entry.data.province} · {yearRange(entry)} · {entry.data.visited.length} 次</span><span class="t-en">City · {entry.data.province} · {yearRange(entry)} · {entry.data.visited.length} visits</span> <em><span class="t-zh">{contentLabel(entry)}</span><span class="t-en">{contentLabelEn(entry)}</span></em></span>
                      <strong>{entry.data.city}</strong>
                      <small>{entry.data.summary}</small>
                      {entry.data.journeys.length > 0 && <span class="journey-name">↳ {entry.data.journeys.map((journey) => journey.name).join(" · ")}</span>}
                    </span>
                    <span class="journey-arrow" aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </details>
          );
        })}

        {residenceFootprints.length > 0 && (
          <details class="journey-year residence-year" data-archive-group open>
            <summary><strong><span class="t-zh">生活坐标</span><span class="t-en">Home Bases</span></strong><span><span class="t-zh">{residenceFootprints.length} 个地点</span><span class="t-en">{residenceFootprints.length} places</span></span><i aria-hidden="true">＋</i></summary>
            <div class="journey-rows">
              {residenceFootprints.map((entry) => (
                <a
                  class:list={["journey-row", `status-${entry.data.status}`]}
                  href={`/footprints/${footprintSlug(entry)}/`}
                  data-archive-entry
                  data-province={entry.data.province}
                  data-journeys={entry.data.journeys.map((journey) => journey.id).join(",")}
                  data-years=""
                  data-content={contentKey(entry)}
                >
                  <span class="journey-num"><span class="t-zh">{entry.data.status === "home" ? "家" : "故"}</span><span class="t-en">{entry.data.status === "home" ? "Home" : "Past"}</span></span>
                  <span class="journey-row-copy">
                    <span class="journey-meta"><span class="t-zh">{entry.data.status === "home" ? `常驻地 · Since ${entry.data.since?.getFullYear() ?? firstYear}` : entry.data.until ? `曾居地 · ${entry.data.until.getFullYear()} 年以前` : "曾居地"}</span><span class="t-en">{entry.data.status === "home" ? `Home base · Since ${entry.data.since?.getFullYear() ?? firstYear}` : entry.data.until ? `Former home · before ${entry.data.until.getFullYear()}` : "Former home"}</span> <em><span class="t-zh">{contentLabel(entry)}</span><span class="t-en">{contentLabelEn(entry)}</span></em></span>
                    <strong>{entry.data.city}</strong>
                    <small>{entry.data.summary}</small>
                  </span>
                  <span class="journey-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </details>
        )}
      </div>
      <div class="archive-empty" data-archive-empty hidden aria-live="polite">
        <strong><span class="t-zh">没有匹配的记录</span><span class="t-en">No matching records</span></strong>
        <p><span class="t-zh">这类内容还在整理中，换个筛选条件看看。</span><span class="t-en">This kind of content is still being organized — try different filters.</span></p>
        <button type="button" data-archive-empty-reset><span class="t-zh">查看全部足迹</span><span class="t-en">View all footprints</span></button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initFootprintArchive() {
    document.querySelectorAll<HTMLElement>("[data-footprint-archive]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      const rows = [...root.querySelectorAll<HTMLElement>("[data-archive-entry]")];
      const groups = [...root.querySelectorAll<HTMLDetailsElement>("[data-archive-group]")];
      const yearButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-archive-year]")];
      const contentButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-archive-content]")];
      const count = root.querySelector<HTMLElement>("[data-archive-count]");
      const provinceLabel = root.querySelector<HTMLElement>("[data-archive-province]");
      const empty = root.querySelector<HTMLElement>("[data-archive-empty]");
      const initialParams = new URL(window.location.href).searchParams;
      const initialProvince = initialParams.get("province") ?? "";
      const initialJourney = initialParams.get("journey") ?? "";
      const initialJourneyChip = initialJourney
        ? document.querySelector<HTMLElement>(`[data-journey-id="${CSS.escape(initialJourney)}"]`)
        : null;
      const lifecycle = new AbortController();
      document.addEventListener("astro:before-swap", () => lifecycle.abort(), { once: true });
      const validParam = (buttons: HTMLButtonElement[], key: "archiveYear" | "archiveContent", value: string | null) =>
        value && buttons.some((button) => button.dataset[key] === value && !button.disabled) ? value : "";
      let activeYear = validParam(yearButtons, "archiveYear", initialParams.get("year"));
      let activeContent = validParam(contentButtons, "archiveContent", initialParams.get("content"));
      // The map selects either a journey or a province, never both; mirror that.
      let activeJourney = initialJourneyChip ? initialJourney : "";
      let activeJourneyName = initialJourneyChip?.querySelector("b")?.textContent ?? "";
      let activeProvince = !activeJourney && rows.some((row) => row.dataset.province === initialProvince) ? initialProvince : "";

      const syncButtons = (buttons: HTMLButtonElement[], active: string, key: "archiveYear" | "archiveContent") => {
        buttons.forEach((button) => {
          const selected = button.dataset[key] === active;
          button.classList.toggle("active", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
      };

      const restoreMobileOpenState = () => {
        if (!window.matchMedia("(max-width: 640px)").matches) return;
        groups.forEach((group, index) => { group.open = index === 0; });
      };

      const applyFilters = () => {
        const hasActiveFilter = Boolean(activeYear || activeContent || activeProvince || activeJourney);
        let visible = 0;
        rows.forEach((row) => {
          const years = (row.dataset.years ?? "").split(",").filter(Boolean);
          const show = (!activeYear || years.includes(activeYear))
            && (!activeContent || row.dataset.content === activeContent)
            && (!activeProvince || row.dataset.province === activeProvince)
            && (!activeJourney || (row.dataset.journeys ?? "").split(",").includes(activeJourney));
          row.hidden = !show;
          if (show) visible += 1;
        });
        groups.forEach((group) => {
          const hasVisible = [...group.querySelectorAll<HTMLElement>("[data-archive-entry]")].some((row) => !row.hidden);
          group.hidden = !hasVisible;
          if (hasActiveFilter && hasVisible) group.open = true;
        });
        if (!hasActiveFilter) restoreMobileOpenState();
        if (count) count.textContent = String(visible);
        if (provinceLabel) {
          const t = (window as any).__T || ((k: string) => k);
          provinceLabel.textContent = activeProvince || (activeJourney
            ? String(t("journeyChip")).replace("{name}", activeJourneyName)
            : String(t("allRegions")));
        }
        if (empty) empty.hidden = visible !== 0;
      };

      // Same replaceState-only rule as the map (see FootprintMap.astro).
      const syncUrl = () => {
        const url = new URL(window.location.href);
        if (activeYear) url.searchParams.set("year", activeYear);
        else url.searchParams.delete("year");
        if (activeContent) url.searchParams.set("content", activeContent);
        else url.searchParams.delete("content");
        window.history.replaceState(window.history.state, "", url);
      };

      restoreMobileOpenState();
      syncButtons(yearButtons, activeYear, "archiveYear");
      syncButtons(contentButtons, activeContent, "archiveContent");
      syncUrl();

      yearButtons.forEach((button) => button.addEventListener("click", () => {
        activeYear = button.dataset.archiveYear ?? "";
        syncButtons(yearButtons, activeYear, "archiveYear");
        syncUrl();
        applyFilters();
      }));
      contentButtons.forEach((button) => button.addEventListener("click", () => {
        activeContent = button.dataset.archiveContent ?? "";
        syncButtons(contentButtons, activeContent, "archiveContent");
        syncUrl();
        applyFilters();
      }));
      document.addEventListener("footprint:province", (event) => {
        activeProvince = (event as CustomEvent<{ province: string }>).detail.province ?? "";
        activeJourney = "";
        activeJourneyName = "";
        applyFilters();
      }, { signal: lifecycle.signal });
      document.addEventListener("footprint:journey", (event) => {
        const detail = (event as CustomEvent<{ journey: string; name?: string }>).detail;
        activeJourney = detail.journey ?? "";
        activeJourneyName = detail.name ?? "";
        activeProvince = "";
        applyFilters();
      }, { signal: lifecycle.signal });
      const resetFilters = () => {
        activeYear = "";
        activeContent = "";
        syncButtons(yearButtons, activeYear, "archiveYear");
        syncButtons(contentButtons, activeContent, "archiveContent");
        syncUrl();
        document.querySelector<HTMLButtonElement>("[data-map-reset]")?.click();
        applyFilters();
      };
      root.querySelector("[data-archive-reset]")?.addEventListener("click", resetFilters);
      root.querySelector("[data-archive-empty-reset]")?.addEventListener("click", resetFilters);
      applyFilters();
    });
  }
  document.addEventListener("astro:page-load", initFootprintArchive);
  initFootprintArchive();
</script>
