---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FootprintLocator from "../../components/footprints/FootprintLocator.astro";
import { SITE } from "../../consts";
import { footprintDateLabel, footprintPath, footprintSlug, getFootprints, isThinFootprint, latestVisit, yearRange } from "../../lib/footprints";
import { getPosts } from "../../lib/posts";
import { responsiveImage } from "../../lib/footprint-media";
import "../../styles/pages/footprints.less";

export async function getStaticPaths() {
  const footprints = await getFootprints();
  const postsByPath = new Map((await getPosts()).map((post) => [post.route.path, post]));
  // Home base / former residence sit outside the travel timeline.
  const travels = footprints.filter((entry) => entry.data.status === "visited");
  return footprints.map((entry) => {
    const travelIndex = travels.indexOf(entry);
    const activeJourney = [...entry.data.journeys].sort((a, b) => b.date.getTime() - a.date.getTime())[0];
    const journeyStops = activeJourney
      ? footprints
          .flatMap((candidate) => candidate.data.journeys
            .filter((journey) => journey.id === activeJourney.id)
            .map((journey) => ({ entry: candidate, order: journey.order })))
          .sort((a, b) => a.order - b.order)
      : [];
    const relatedPosts = entry.data.posts.map((path) => {
      const post = postsByPath.get(path);
      if (!post) throw new Error(`${entry.filePath}: posts 里的 ${path} 不是已发布文章的路径（需带结尾斜杠）`);
      return { title: post.entry.data.title, path, date: post.entry.data.date };
    });
    const currentStop = journeyStops.findIndex((stop) => footprintSlug(stop.entry) === footprintSlug(entry));
    return {
      params: { slug: footprintSlug(entry) },
      props: {
        entry,
        newer: travelIndex > 0 ? travels[travelIndex - 1] : undefined,
        older: travelIndex >= 0 ? travels[travelIndex + 1] : undefined,
        activeJourney,
        relatedPosts,
        tripPrevious: currentStop > 0 ? journeyStops[currentStop - 1].entry : undefined,
        tripNext: currentStop >= 0 && currentStop < journeyStops.length - 1 ? journeyStops[currentStop + 1].entry : undefined,
        journeyStops: journeyStops.map((stop) => ({
          city: stop.entry.data.city,
          path: footprintPath(stop.entry),
          order: stop.order,
          current: footprintSlug(stop.entry) === footprintSlug(entry),
          province: stop.entry.data.province,
          coordinates: stop.entry.data.coordinates,
        })),
      },
    };
  });
}

const { entry, newer, older, activeJourney, relatedPosts, tripPrevious, tripNext, journeyStops } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const latest = latestVisit(entry);
const isHome = data.status === "home";
const isLived = data.status === "lived";
const homeSince = data.since ?? data.visited[0];
const pad2 = (value: number) => String(value).padStart(2, "0");
const ymd = (date: Date) => `${date.getFullYear()}.${pad2(date.getMonth() + 1)}.${pad2(date.getDate())}`;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const previousStop = activeJourney ? tripPrevious : newer;
const nextStop = activeJourney ? tripNext : older;
const cover = data.cover ? responsiveImage(data.cover, [800, 1200, 1600]) : undefined;
const photos = data.photos.map((photo) => ({ ...photo, image: responsiveImage(photo.src, [480, 800, 1200]) }));
const photoSizes = photos.length === 1 ? "(max-width: 760px) 100vw, 720px" : "(max-width: 560px) 100vw, (max-width: 760px) 50vw, 350px";
const placeLocation = [data.province, data.prefecture, data.city].filter((value, index, values) => value && values.indexOf(value) === index).join(" · ");
---

<BaseLayout
  active="footprints"
  title={data.title}
  description={data.summary}
  image={data.cover}
  type="article"
  article={{ date: latest, author: SITE.author, tags: data.tags }}
  noindex={isThinFootprint(entry)}
>
  <div class:list={["article-shell", "footprint-detail", { "status-home": isHome }]}>
    <nav class="footprint-breadcrumb" aria-label="面包屑" data-tt="aria-label" data-tt-aria-label="面包屑|Breadcrumb">
      <a href="/footprints/"><span class="t-zh" data-pagefind-ignore>我的足迹</span><span class="t-en" data-pagefind-ignore>Footprints</span></a><span>/</span><span>{data.province}</span><span>/</span><strong>{data.city}</strong>
    </nav>

    <section class="footprint-case-head">
      <div class="kicker"><span class="rule"></span><span><span class="t-zh" data-pagefind-ignore>{isHome ? `常驻地 · ${data.province}` : isLived ? `曾居地 · ${data.province}` : `${data.province} · ${yearRange(entry)}`}</span><span class="t-en" data-pagefind-ignore>{isHome ? `Home Base · ${data.province}` : isLived ? `Once Home · ${data.province}` : `${data.province} · ${yearRange(entry)}`}</span></span><span class="rule"></span></div>
      <h1>{data.title}</h1>
      <p>{data.summary}</p>
      <div class="case-byline">
        {isHome
          ? <><span><span class="t-zh" data-pagefind-ignore>生活的圆心</span><span class="t-en" data-pagefind-ignore>Center of life</span></span><span class="sep"></span><span><span class="t-zh" data-pagefind-ignore>Since {homeSince.getFullYear()} · 至今</span><span class="t-en" data-pagefind-ignore>Since {homeSince.getFullYear()} · present</span></span></>
          : isLived
            ? <><span><span class="t-zh" data-pagefind-ignore>成长的原点</span><span class="t-en" data-pagefind-ignore>Where it began</span></span><span class="sep"></span><span><span class="t-zh" data-pagefind-ignore>{data.until ? `${data.until.getFullYear()}年以前` : yearRange(entry)}</span><span class="t-en" data-pagefind-ignore>{data.until ? `before ${data.until.getFullYear()}` : yearRange(entry)}</span></span></>
          : <><span><span class="t-zh" data-pagefind-ignore>{data.visited.length} 次抵达</span><span class="t-en" data-pagefind-ignore>{data.visited.length} visits</span></span><span class="sep"></span><span><span class="t-zh" data-pagefind-ignore>最近 {ymd(latest)}</span><span class="t-en" data-pagefind-ignore>Latest {ymd(latest)}</span></span></>}
        {data.sample && <><span class="sep"></span><span class="accent"><span class="t-zh" data-pagefind-ignore>示例内容</span><span class="t-en" data-pagefind-ignore>Sample</span></span></>}
        {activeJourney && <><span class="sep"></span><span class="accent">{activeJourney.name}</span></>}
      </div>
    </section>

    {cover && (
      <figure class="footprint-cover">
        <img
          src={cover.src}
          srcset={cover.srcset}
          sizes={cover.srcset ? "(max-width: 1180px) 100vw, 980px" : undefined}
          width={cover.width}
          height={cover.height}
          alt={data.coverAlt ?? `${data.city}旅行照片`}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>{data.city} · {isHome ? `Home Base Since ${homeSince.getFullYear()}` : yearRange(entry)}</figcaption>
      </figure>
    )}

    <div class="footprint-meta-strip">
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>地点</span><span class="t-en" data-pagefind-ignore>Place</span></span><span class="value">{placeLocation}</span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>坐标</span><span class="t-en" data-pagefind-ignore>Coords</span></span><span class="value">{data.coordinates[1].toFixed(2)}°N · {data.coordinates[0].toFixed(2)}°E</span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>类型</span><span class="t-en" data-pagefind-ignore>Type</span></span><span class="value"><span class="t-zh" data-pagefind-ignore>{isHome ? "常驻地" : isLived ? "曾居地" : `城市 · ${data.visited.length} 次`}</span><span class="t-en" data-pagefind-ignore>{isHome ? "Home Base" : isLived ? "Once Home" : `City · ${data.visited.length} visits`}</span></span></div>
      <div><span class="label"><span class="t-zh" data-pagefind-ignore>时间</span><span class="t-en" data-pagefind-ignore>Time</span></span><span class="value"><span class="t-zh" data-pagefind-ignore>{isHome ? `${homeSince.getFullYear()}—至今` : isLived && data.until ? `${data.until.getFullYear()}年以前` : yearRange(entry)}</span><span class="t-en" data-pagefind-ignore>{isHome ? `${homeSince.getFullYear()}—present` : isLived && data.until ? `before ${data.until.getFullYear()}` : yearRange(entry)}</span></span></div>
    </div>

    <div class="footprint-story-layout">
      <article class="footprint-prose">
        <Content />

        {data.events.length > 0 && (
          <section class="footprint-event-section" aria-labelledby="footprint-event-title">
            <div class="photo-journal-head">
              <h2 id="footprint-event-title"><span class="t-zh" data-pagefind-ignore>时间轴</span><span class="t-en" data-pagefind-ignore>Timeline</span></h2>
              <span>{data.events.length} Moments</span>
            </div>
            <ol class="footprint-events">
              {[...data.events].sort((a, b) => b.date.getTime() - a.date.getTime()).map((event) => (
                <li>
                  <time>{footprintDateLabel(event.date, event.precision)}</time>
                  <div>
                    <strong>{event.href
                      ? event.href.startsWith("/")
                        ? <a href={event.href}>{event.title} ↗</a>
                        : <a href={event.href} target="_blank" rel="noopener">{event.title} ↗</a>
                      : event.title}</strong>
                    {event.note && <p>{event.note}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {relatedPosts.length > 0 && (
          <section class="footprint-event-section footprint-posts" aria-labelledby="footprint-posts-title">
            <div class="photo-journal-head">
              <h2 id="footprint-posts-title"><span class="t-zh" data-pagefind-ignore>相关文章</span><span class="t-en" data-pagefind-ignore>Related Posts</span></h2>
              <span>{relatedPosts.length} Posts</span>
            </div>
            <ol class="footprint-events">
              {relatedPosts.map((post) => (
                <li>
                  <time>{footprintDateLabel(post.date, "day")}</time>
                  <div><strong><a href={post.path}>{post.title} ↗</a></strong></div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {data.photos.length > 0 && (
          <section class="photo-journal" aria-labelledby="photo-journal-title">
            <div class="photo-journal-head">
              <h2 id="photo-journal-title"><span class="t-zh" data-pagefind-ignore>照片记录</span><span class="t-en" data-pagefind-ignore>Photo Journal</span></h2>
              <span>{photos.length} Frames</span>
            </div>
            <div class="photo-grid">
              {photos.map((photo, index) => (
                <figure>
                  <button type="button" class="photo-open" data-photo-index={index} aria-label={`放大照片：${photo.alt}`} data-tt="aria-label" data-tt-aria-label={`放大照片：${photo.alt}|Enlarge photo: ${photo.alt}`}>
                    <img
                      src={photo.image.src}
                      srcset={photo.image.srcset}
                      sizes={photo.image.srcset ? photoSizes : undefined}
                      width={photo.image.width}
                      height={photo.image.height}
                      alt={photo.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                  <figcaption>
                    <span>{photo.caption ?? photo.alt}</span>
                    {photo.credit && (
                      photo.creditUrl
                        ? <a href={photo.creditUrl} target="_blank" rel="noopener">Photo · {photo.credit} ↗</a>
                        : <small>Photo · {photo.credit}</small>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="footprint-side">
        <div class="side-block">
          <span class="side-label"><span class="t-zh" data-pagefind-ignore>位置</span><span class="t-en" data-pagefind-ignore>Location</span></span>
          <FootprintLocator
            city={data.city}
            province={data.province}
            coordinates={data.coordinates}
            journeyName={activeJourney?.name}
            stops={journeyStops}
          />
        </div>
        <div class="side-block">
          <span class="side-label"><span class="t-zh" data-pagefind-ignore>{isHome ? "常驻时间" : "到访日期"}</span><span class="t-en" data-pagefind-ignore>{isHome ? "Living" : "Visited"}</span></span>
          {isHome
            ? <ol><li class="home-period"><span class="t-zh" data-pagefind-ignore>{ymd(homeSince)} — 至今</span><span class="t-en" data-pagefind-ignore>{ymd(homeSince)} — present</span></li></ol>
            : isLived
              ? <ol><li class="home-period"><span class="t-zh" data-pagefind-ignore>{data.until ? `${data.until.getFullYear()}年以前` : yearRange(entry)}</span><span class="t-en" data-pagefind-ignore>{data.until ? `before ${data.until.getFullYear()}` : yearRange(entry)}</span></li></ol>
              : <ol>{[...data.visited].sort((a, b) => b.getTime() - a.getTime()).map((date) => <li>{footprintDateLabel(date, data.precision)}</li>)}</ol>}
        </div>
        {activeJourney && journeyStops.length > 1 && (
          <div class="side-block footprint-journey-stops">
            <span class="side-label"><span class="t-zh" data-pagefind-ignore>本次行程</span><span class="t-en" data-pagefind-ignore>Journey</span></span>
            <strong>{activeJourney.name}</strong>
            <ol>
              {journeyStops.map((stop) => (
                <li class:list={{ current: stop.current }}><a href={stop.path}><span>{String(stop.order).padStart(2, "0")}</span>{stop.city}</a></li>
              ))}
            </ol>
          </div>
        )}
        <div class="side-block">
          <span class="side-label"><span class="t-zh" data-pagefind-ignore>关键词</span><span class="t-en" data-pagefind-ignore>Tags</span></span>
          <div class="footprint-tags">{data.tags.map((tag) => <span>#{tag}</span>)}</div>
        </div>
        {toc.length > 0 && (
          <div class="side-block footprint-toc">
            <span class="side-label"><span class="t-zh" data-pagefind-ignore>此行小记</span><span class="t-en" data-pagefind-ignore>Contents</span></span>
            <ol>{toc.map((heading) => <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
          </div>
        )}
      </aside>
    </div>

    <div class="footprint-next-prev">
      {previousStop ? <a href={footprintPath(previousStop)}><span><span class="t-zh" data-pagefind-ignore>← {activeJourney ? "同程上一站" : "较近一站"}</span><span class="t-en" data-pagefind-ignore>← {activeJourney ? "Previous stop" : "Nearer stop"}</span></span><strong>{previousStop.data.city}</strong></a> : <span></span>}
      <a class="back-map" href={activeJourney ? `/footprints/?journey=${activeJourney.id}` : "/footprints/"}><span class="t-zh" data-pagefind-ignore>回到地图</span><span class="t-en" data-pagefind-ignore>Back to map</span></a>
      {nextStop ? <a class="next" href={footprintPath(nextStop)}><span><span class="t-zh" data-pagefind-ignore>{activeJourney ? "同程下一站" : "更早一站"} →</span><span class="t-en" data-pagefind-ignore>{activeJourney ? "Next stop" : "Earlier stop"} →</span></span><strong>{nextStop.data.city}</strong></a> : <span></span>}
    </div>
  </div>

  {data.photos.length > 0 && (
    <>
      <script is:inline type="application/json" data-photo-data set:html={JSON.stringify(photos.map((photo) => ({ src: photo.image.full, alt: photo.alt, caption: photo.caption })))}></script>
      <dialog class="photo-lightbox" data-photo-lightbox>
        <button type="button" class="lightbox-close" aria-label="关闭照片" data-tt="aria-label" data-tt-aria-label="关闭照片|Close photo">×</button>
        <button type="button" class="lightbox-prev" aria-label="上一张照片" data-tt="aria-label" data-tt-aria-label="上一张照片|Previous photo">←</button>
        <figure><img alt="" decoding="async" /><figcaption aria-live="polite"></figcaption></figure>
        <button type="button" class="lightbox-next" aria-label="下一张照片" data-tt="aria-label" data-tt-aria-label="下一张照片|Next photo">→</button>
      </dialog>
    </>
  )}

  <script>
    function initFootprintGallery() {
      const dialog = document.querySelector<HTMLDialogElement>('[data-photo-lightbox]');
      const photoData = document.querySelector<HTMLScriptElement>('[data-photo-data]');
      if (!dialog || dialog.dataset.ready === 'true') return;
      const photos = JSON.parse(photoData?.textContent || '[]') as Array<{ src: string; alt: string; caption?: string }>;
      if (!photos.length) return;
      dialog.dataset.ready = 'true';
      const image = dialog.querySelector<HTMLImageElement>('img')!;
      const caption = dialog.querySelector<HTMLElement>('figcaption')!;
      let current = 0;
      const show = (index: number) => {
        current = (index + photos.length) % photos.length;
        image.src = photos[current].src;
        image.alt = photos[current].alt;
        caption.textContent = photos[current].caption || photos[current].alt;
      };
      document.querySelectorAll<HTMLButtonElement>('[data-photo-index]').forEach((button) => {
        button.addEventListener('click', () => {
          show(Number(button.dataset.photoIndex || 0));
          dialog.showModal();
        });
      });
      dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
      dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
        else if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
      });
      let swipeStart: { x: number; y: number } | null = null;
      dialog.addEventListener('touchstart', (event) => {
        swipeStart = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
      }, { passive: true });
      dialog.addEventListener('touchend', (event) => {
        if (!swipeStart) return;
        const dx = event.changedTouches[0].clientX - swipeStart.x;
        const dy = event.changedTouches[0].clientY - swipeStart.y;
        swipeStart = null;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
      });
    }
    document.addEventListener('astro:page-load', initFootprintGallery);
    initFootprintGallery();
  </script>
</BaseLayout>
