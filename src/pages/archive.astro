---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/archive.less";
import { SITE } from "../consts";
import { getPosts, ganzhi, readingStats, type LoadedPost } from "../lib/posts";

const posts = await getPosts();
const totalMin = posts.reduce(
  (a, p) => a + readingStats(p.entry.body ?? "").minutes,
  0,
);

const byYear = new Map<number, LoadedPost[]>();
for (const p of posts) {
  const y = p.entry.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const pad2 = (n: number) => String(n).padStart(2, "0");
const md = (d: Date) => `${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}`;
const ymd = (d: Date) => `${d.getFullYear()}.${md(d)}`;
---
<BaseLayout active="archive" title="归档">
  <div class="article-shell">
    <section class="page-head">
      <div>
        <div class="kicker">
          <span class="dot"></span>
          <span><span class="t-zh" data-pagefind-ignore>全部归档</span><span class="t-en" data-pagefind-ignore>Archive</span></span>
          <span class="rule"></span>
          <span><span class="t-zh" data-pagefind-ignore>按年序排列</span><span class="t-en" data-pagefind-ignore>Chronological by year</span></span>
        </div>
        <h1><span class="t-zh" data-pagefind-ignore>归档手稿</span><span class="t-en" data-pagefind-ignore>Archive</span></h1>
        <p class="sub">
          <span class="t-zh" data-pagefind-ignore>从 {SITE.since} 到今天——从测试到全栈，再到 AI 工程师。这里是所有正式发表的写作。</span>
          <span class="t-en" data-pagefind-ignore>From {SITE.since} to today — from testing to full-stack, and on to AI engineering. Everything formally published lives here.</span>
        </p>
      </div>
      <div class="right">
        <div class="big">{posts.length}</div>
        <div><span class="t-zh" data-pagefind-ignore>累计文章</span><span class="t-en" data-pagefind-ignore>Total Posts</span></div>
        <div style="margin-top:10px">· · ·</div>
        <div><span class="t-zh" data-pagefind-ignore>{totalMin} 分钟</span><span class="t-en" data-pagefind-ignore>{totalMin} min</span></div>
        <div><span class="t-zh" data-pagefind-ignore>{years.length} 年</span><span class="t-en" data-pagefind-ignore>{years.length} Years</span></div>
      </div>
    </section>

    {years.map((y) => {
      const list = byYear.get(y)!;
      const yearMin = list.reduce((a, p) => a + readingStats(p.entry.body ?? "").minutes, 0);
      const newest = list[0].entry.data.date;
      const oldest = list[list.length - 1].entry.data.date;
      return (
        <section class="year-block">
          <div class="year-rail">
            <div class="year-num">{y}</div>
            <div class="year-cn">{ganzhi(y)}</div>
            <div class="year-meta">
              <span><span class="t-zh" data-pagefind-ignore><em>{list.length}</em> 篇 · {yearMin} 分钟</span><span class="t-en" data-pagefind-ignore><em>{list.length}</em> posts · {yearMin} min</span></span>
              <span><span class="t-zh" data-pagefind-ignore>最早 {md(oldest)} → 最新 {md(newest)}</span><span class="t-en" data-pagefind-ignore>First {md(oldest)} → Last {md(newest)}</span></span>
            </div>
          </div>
          <div class="timeline">
            {list.map((p) => {
              const { minutes } = readingStats(p.entry.body ?? "");
              return (
                <a href={p.route.path} class="entry">
                  <span class="date-cell">{ymd(p.entry.data.date)}</span>
                  <div>
                    <h4>{p.entry.data.title}</h4>
                    <div class="meta-row">
                      {p.entry.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                    </div>
                  </div>
                  <span class="right"><span class="t-zh" data-pagefind-ignore>{minutes} 分钟</span><span class="t-en" data-pagefind-ignore>{minutes} min</span></span>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
