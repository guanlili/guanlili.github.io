---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="404">
  <div class="article-shell">
    <header class="page-head">
      <div>
        <div class="kicker">
          <span class="dot"></span>
          <span><span class="t-zh">404 · 未找到</span><span class="t-en">404 · Not Found</span></span>
          <span class="rule"></span>
          <span><span class="t-zh">页面不存在</span><span class="t-en">Page Not Found</span></span>
        </div>
        <h1><span class="t-zh">这一页走丢了</span><span class="t-en">This page went missing</span></h1>
        <p class="sub">
          <span class="t-zh">链接可能已经失效，或者文章被搬到了别处。不如回首页，或翻翻归档。</span>
          <span class="t-en">The link may be broken, or the post may have moved. Head home, or browse the archive.</span>
        </p>
      </div>
      <div class="right"><div class="big">404</div><div><span class="t-zh">页面未找到</span><span class="t-en">Page Not Found</span></div></div>
    </header>
    <nav class="pager-nav">
      <a href="/"><span class="t-zh">&larr; 回首页</span><span class="t-en">&larr; Home</span></a>
      <span class="spacer"></span>
      <a href="/archive/"><span class="t-zh">去归档 &rarr;</span><span class="t-en">Archive &rarr;</span></a>
    </nav>
  </div>
</BaseLayout>
