---
import { SITE, GA_TRACK_ID, BAIDU_TRACK_ID } from "../consts";
import Icons from "../components/Icons.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/site.less";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  active?: string;
  bodyClass?: string;
  article?: { date?: Date; author?: string; tags?: string[] };
}

const {
  title,
  description = SITE.description,
  image = SITE.avatar,
  type = "website",
  active,
  bodyClass = "",
  article,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE.seoTitle}` : SITE.seoTitle;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="keywords" content={SITE.keywords} />
  <meta name="theme-color" content={SITE.themeColor} />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />

  <!-- Open Graph -->
  <meta property="og:title" content={title ? `${title} - ${SITE.seoTitle}` : SITE.seoTitle} />
  <meta property="og:type" content={type} />
  <meta property="og:description" content={description} />
  {type === "article" && article?.date && (
    <meta property="article:published_time" content={article.date.toISOString()} />
  )}
  {type === "article" && article?.author && (
    <meta property="article:author" content={article.author} />
  )}
  {type === "article" && article?.tags?.map((t) => (
    <meta property="article:tag" content={t} />
  ))}
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.seoTitle} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <title>{pageTitle}</title>

  <link rel="manifest" href="/pwa/manifest.json" />
  <link rel="shortcut icon" href="/img/favicon.ico" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={SITE.seoTitle} href={`${SITE.url}/feed.xml`} />

  <!-- Fonts: Noto Serif SC (display) + Noto Sans SC (body) + JetBrains Mono (meta/code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;600&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" />

  <!-- JSON-LD -->
  {type === "article" ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: ogImage,
      datePublished: article?.date?.toISOString(),
      dateModified: article?.date?.toISOString(),
      author: { "@type": "Person", name: article?.author || SITE.author },
      publisher: { "@type": "Organization", name: SITE.seoTitle, logo: { "@type": "ImageObject", url: `${SITE.url}${SITE.avatar}` } },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
    })} />
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.seoTitle,
      url: SITE.url,
      description: SITE.description,
      potentialAction: { "@type": "SearchAction", target: `${SITE.url}/tags/`, "query-input": "required name=search_term_string" },
    })} />
  )}

  <!-- Prevent dark-mode flash -->
  <script is:inline>
    (function () {
      var saved = localStorage.getItem("theme");
      if (saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    })();
  </script>
</head>

<body ontouchstart="" class={bodyClass}>
  <Icons />
  <a href="#main-content" class="skip-nav">跳到正文</a>
  <Nav active={active} />

  <!-- Search overlay -->
  <div class="search-page">
    <div class="search-icon-close-container">
      <span class="search-icon-close"><svg class="icon"><use href="#icon-chevron-down"></use></svg></span>
    </div>
    <div class="search-main container">
      <div class="row">
        <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
          <input type="text" id="search-input" placeholder="$ grep..." aria-label="搜索文章" />
          <div id="search-results" class="mini-post-list"></div>
        </div>
      </div>
    </div>
  </div>

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <div id="back-to-top" title="返回顶部" aria-label="返回顶部" role="button" tabindex="0">
    <svg class="icon"><use href="#icon-arrow-up"></use></svg>
  </div>

  <script is:inline defer src="/js/hux-blog.min.js"></script>
  <script is:inline defer src="/js/simple-jekyll-search.min.js"></script>

  {GA_TRACK_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACK_ID}`}></script>
      <script is:inline define:vars={{ GA_TRACK_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", GA_TRACK_ID);
      </script>
    </>
  )}
  {BAIDU_TRACK_ID && (
    <script is:inline define:vars={{ BAIDU_TRACK_ID }}>
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement("script");
        hm.src = "//hm.baidu.com/hm.js?" + BAIDU_TRACK_ID;
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  )}
</body>
</html>
